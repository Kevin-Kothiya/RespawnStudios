image_xscale = 0.5;   // optional: shrink the sprite (the collision mask scales too)
image_yscale = 0.5;

h_speed     = 0;      // set by the player when thrown
v_speed     = 0;
grav        = 0.5;
bounce_damp = 0.5;    // how much speed is kept after a bounce
fuse        = 120;    // steps until it explodes (2 seconds at 60 fps)

